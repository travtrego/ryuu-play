{
  "name": "@ptcg/bot-bench",
  "version": "0.2.1",
  "description": "Headless, seeded bot-vs-bot benchmark harness for simple-bot.",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint -c .eslintrc.js --ext .ts src",
    "compile": "tsc",
    "build": "npm run lint && npm run test && npm run compile",
    "test": "nyc -e \".ts\" -x \"src/**/*.spec.ts\" jasmine-ts \"src/**/*.spec.ts\"",
    "bench": "tsc && node dist/cli.js",
    "bench:smoke": "node dist/cli.js --games 21 --seed 1 --max-errors 0 --max-guard-aborts 0 --max-stalled 0 --max-illegal-moves 0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ptcg/common": "*",
    "@ptcg/sets": "*",
    "@ptcg/simple-bot": "*"
  },
  "devDependencies": {
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.87",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.31.1",
    "jasmine": "^3.9.0",
    "jasmine-ts": "~0.4.0",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~4.9.5"
  }
}
